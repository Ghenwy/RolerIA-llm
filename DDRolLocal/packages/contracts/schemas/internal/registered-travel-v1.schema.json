{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nyx:registered-travel:1.0",
  "title": "RegisteredTravelV1",
  "description": "[DESIGN] AMD-005: explicit operator-registered travel, not an LLM proposal. No encounter, inventory or tactical effects in this profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_id", "actor_id", "from_location_id", "to_location_id", "character_ids", "duration_minutes", "source_refs", "destination_scene"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "route_id": {"$ref": "#/$defs/id"},
    "actor_id": {"$ref": "#/$defs/id"},
    "from_location_id": {"$ref": "#/$defs/id"},
    "to_location_id": {"$ref": "#/$defs/id"},
    "character_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "destination_scene": {
      "type": "object", "additionalProperties": false,
      "required": ["location_id", "summary", "present_character_ids", "immediate_threats", "open_questions"],
      "properties": {
        "location_id": {"$ref": "#/$defs/id"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 400},
        "present_character_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "immediate_threats": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
        "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
}
