{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nyx:memory-record:1.0",
  "title": "MemoryRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "memory_id", "campaign_id", "branch_id", "retention_class", "content", "source_refs", "created_state_version", "updated_state_version", "exact_payload_sha256"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "memory_id": { "type": "string", "pattern": "^MEMORY-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "campaign_id": { "type": "string", "pattern": "^CAMPAIGN-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "branch_id": { "type": "string", "pattern": "^BRANCH-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "retention_class": { "enum": ["EXACT", "DURABLE", "EPISODIC", "EVICTABLE"] },
    "content": { "type": "object" },
    "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "created_state_version": { "type": "integer", "minimum": 0 },
    "updated_state_version": { "type": "integer", "minimum": 0 },
    "exact_payload_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    { "if": { "properties": { "retention_class": { "const": "EXACT" }, "exact_payload_sha256": { "type": "null" } }, "required": ["retention_class", "exact_payload_sha256"] }, "then": false }
  ]
}
