{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nyx:rule-source-record:1.0",
  "title": "RuleSourceRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "source_kind", "title", "edition", "version_or_date", "ownership_assertion", "local_excerpt_ref", "allowed_scope", "content_sha256", "public_distribution_allowed", "enabled"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_id": { "type": "string", "pattern": "^SOURCE-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "source_kind": { "enum": ["HOUSE_RULE", "OFFICIAL_ERRATA", "SRD_OGC", "PERSISTED_RULING", "USER_OWNED_EXCERPT"] },
    "title": { "type": "string", "minLength": 1 },
    "edition": { "type": ["string", "null"] },
    "version_or_date": { "type": ["string", "null"] },
    "ownership_assertion": { "type": ["string", "null"] },
    "local_excerpt_ref": { "type": ["string", "null"], "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$" },
    "allowed_scope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "content_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "public_distribution_allowed": { "type": "boolean" },
    "enabled": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "source_kind": { "const": "USER_OWNED_EXCERPT" } }, "required": ["source_kind"] },
      "then": {
        "properties": {
          "ownership_assertion": { "type": "string", "minLength": 1 },
          "local_excerpt_ref": { "type": "string", "minLength": 1 },
          "allowed_scope": { "type": "array", "minItems": 1 },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "public_distribution_allowed": { "const": false }
        }
      }
    }
  ]
}
