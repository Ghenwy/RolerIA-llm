{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nyx:checkpoint-manifest:1.1",
  "title": "CheckpointManifestV11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "checkpoint_id", "campaign_id", "branch_id", "parent_checkpoint_id", "state_version",
    "state_file", "state_sha256", "event_file", "event_count", "event_tail_event_id", "event_tail_hash",
    "campaign_time", "rng_hash", "schema_fingerprints", "prompt_fingerprints", "model_fingerprint", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "checkpoint_id": { "type": "string", "pattern": "^CHECKPOINT-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "campaign_id": { "type": "string", "pattern": "^CAMPAIGN-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "branch_id": { "type": "string", "pattern": "^BRANCH-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "parent_checkpoint_id": { "type": ["string", "null"], "pattern": "^CHECKPOINT-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "state_version": { "type": "integer", "minimum": 0 },
    "state_file": { "$ref": "#/$defs/relative_path" },
    "state_sha256": { "$ref": "#/$defs/sha256" },
    "event_file": { "$ref": "#/$defs/relative_path" },
    "event_count": { "type": "integer", "minimum": 0 },
    "event_tail_event_id": { "type": ["string", "null"], "pattern": "^EV(?:ENT)?-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "event_tail_hash": { "$ref": "#/$defs/sha256" },
    "campaign_time": { "type": "string", "minLength": 1 },
    "rng_hash": { "$ref": "#/$defs/sha256" },
    "schema_fingerprints": { "$ref": "#/$defs/fingerprint_map" },
    "prompt_fingerprints": { "$ref": "#/$defs/fingerprint_map" },
    "model_fingerprint": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relative_path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$" },
    "fingerprint_map": { "type": "object", "propertyNames": { "minLength": 1 }, "additionalProperties": { "$ref": "#/$defs/sha256" } }
  }
}
