{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nyx:turn-envelope:1.0",
  "title": "TurnEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "turn_id", "phase", "base_state_version", "player_input", "context_refs", "worker_results", "deterministic_rolls", "language"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "campaign_id": { "type": "string", "pattern": "^CAMPAIGN-[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128 },
    "turn_id": { "type": "string", "pattern": "^TURN-[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128 },
    "phase": { "enum": ["PLAN", "RESOLVE"] },
    "base_state_version": { "type": "integer", "minimum": 0 },
    "player_input": { "type": ["string", "null"], "maxLength": 32768 },
    "context_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/content_ref" },
      "uniqueItems": true
    },
    "worker_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result_ref" },
      "uniqueItems": true
    },
    "deterministic_rolls": {
      "type": "array",
      "items": { "$ref": "#/$defs/roll_ref" }
    },
    "language": { "type": "string", "default": "es", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "PLAN" } }, "required": ["phase"] },
      "then": { "properties": { "player_input": { "type": "string", "minLength": 1 }, "worker_results": { "type": "array", "maxItems": 0 }, "deterministic_rolls": { "type": "array", "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "phase": { "const": "RESOLVE" } }, "required": ["phase"] },
      "then": { "properties": { "player_input": { "type": "null" } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 256 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "worker_id", "base_state_version", "status", "sha256"],
      "properties": {
        "job_id": { "type": "string", "minLength": 1 },
        "worker_id": { "type": "string", "minLength": 1 },
        "base_state_version": { "type": "integer", "minimum": 0 },
        "status": { "const": "COMPLETED" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "roll_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roll_id", "expression", "result", "rng_counter"],
      "properties": {
        "roll_id": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 },
        "result": { "type": "integer" },
        "rng_counter": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
