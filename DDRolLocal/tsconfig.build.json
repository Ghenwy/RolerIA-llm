{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "bootstrap/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
